---
import Base from '../../layouts/Base.astro';
import BriefCards from '../../components/BriefCards.astro';
import { getBriefs } from '../../lib/briefs';

const briefs = await getBriefs();
---
<Base title="Briefs" description="One finding from a primary source each: what it shows, what it doesn't, and what to check.">
  <section class="page-head">
    <div class="wrap">
      <h1>Briefs</h1>
      <p class="lede">One finding from a primary source each: what it shows, what it doesn&rsquo;t, and what a facility team might check. Every brief carries a date to review it by.</p>
    </div>
  </section>
  <div class="wrap briefs-list">
    <BriefCards briefs={briefs} />
  </div>
</Base>

<style>
  .briefs-list { padding-top: 26px; padding-bottom: 30px; }
</style>
