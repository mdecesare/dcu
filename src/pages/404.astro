---
// Shown by Netlify for any address that doesn't exist (built as dist/404.html).
import Base from '../layouts/Base.astro';

const destinations = [
  { href: '/', label: 'Home', note: 'The latest at a glance' },
  { href: '/procurement', label: 'Procurement', note: 'Procurement Pulse lead times' },
  { href: '/regulation', label: 'Regulation', note: 'Regulatory Watch' },
];
---
<Base title="Page not found" description="The page you requested could not be found.">
  <section class="page-head">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede">The page you requested couldn't be found. It may have moved, or the address may be mistyped.</p>
    </div>
  </section>

  <div class="wrap">
    <nav class="panel panel-reading" aria-label="Where to go instead">
      <ul class="ways">
        {destinations.map((d) => (
          <li><a href={d.href}><strong>{d.label}</strong><span>{d.note}</span></a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .ways { list-style: none; display: grid; gap: 10px; }
  .ways a { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; align-items: baseline; padding: 13px 16px; border: 1px solid var(--line); border-radius: 7px; background: #f6f9fc; }
  .ways a:hover { border-color: var(--blue); background: var(--blue-lt); }
  .ways strong { color: var(--blue-dk); font-size: 16px; font-weight: 600; }
  .ways span { color: var(--ink-2); font-size: 14px; }
</style>
