---
import ContentPage from '../layouts/ContentPage.astro';
import { getEntry } from 'astro:content';
import { siteSettings } from '../site-settings';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const { Content } = await entry.render();

// Closing line. "Subscribe" only appears once a newsletter form is live;
// the address only becomes a link once listed in confirmedEmailAddresses.
const sourceAddress = 'hello@datacenterupdate.com';
const addressConfirmed = siteSettings.confirmedEmailAddresses.map((a) => a.toLowerCase()).includes(sourceAddress);
const subscribeLive = siteSettings.showSubscribe && siteSettings.subscribeFormUrl.trim() !== '';
---
<ContentPage title={entry.data.title} description={entry.data.description}>
  <Content />

  <hr />

  <p class="about-cta">
    {subscribeLive
      ? <Fragment><a href="/#subscribe"><strong>Subscribe for important DCU updates</strong></a>, or <strong>send us a source</strong></Fragment>
      : <strong>Send us a source</strong>}
    {' '}— a filing, dataset, or development you think we should be watching:{' '}
    {addressConfirmed ? <a href={`mailto:${sourceAddress}`}>{sourceAddress}</a> : sourceAddress}
  </p>
</ContentPage>
