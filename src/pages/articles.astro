---
// Background articles list. Linked from the footer, not the main menu.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/dates';
import { smartQuotes } from '../lib/typography';

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Background" description="Background articles from DataCenterUpdate.">
  <section class="page-head">
    <div class="wrap">
      <h1>Background</h1>
    </div>
  </section>

  <div class="wrap">
    <div class="panel panel-reading">
      {articles.map((article) => (
        <article class="bg-item">
          <p class="bg-date">Published {formatDate(article.data.date)}</p>
          <h2><a href={`/articles/${article.slug}`}>{smartQuotes(article.data.title)}</a></h2>
          <p class="bg-sum">{smartQuotes(article.data.summary)}</p>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .bg-item { border-bottom: 1px solid var(--line-2); padding: 16px 0; }
  .bg-item:first-child { padding-top: 0; }
  .bg-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .bg-date { font-size: 12.5px; color: var(--ink-2); margin-bottom: 4px; }
  h2 { font-size: 17px; line-height: 1.35; font-weight: 600; margin-bottom: 5px; }
  h2 a { color: var(--blue-dk); }
  h2 a:hover { text-decoration: underline; }
  .bg-sum { font-size: 14px; color: var(--ink-2); line-height: 1.55; }
</style>
