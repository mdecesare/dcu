---
import Base from '../layouts/Base.astro';
import SourceMark from '../components/SourceMark.astro';
import BriefItem from '../components/BriefItem.astro';
import WeekStrip from '../components/WeekStrip.astro';
import { getCollection } from 'astro:content';
import { siteSettings } from '../site-settings';
import { getEditions } from '../lib/procurement';
import { getRegulationItems } from '../lib/regulation';
import { parsePulseSections, parsePulseDisclosures } from '../lib/pulse-sections';
import { SOURCE_TYPES } from '../lib/source-types.mjs';
import { smartQuotes } from '../lib/typography';
import { pjm, eiaPrices, eiaYtdLabel, eiaTableUrls, pct } from '../lib/power';

// The homepage is a front door, not a second copy of the Procurement page: it shows a few
// figures chosen in src/site-settings.ts and links to the editions that hold the rest.
const [latest] = await getEditions();
const pulseSections = parsePulseSections(latest.body);
const equipmentClassCount = pulseSections.filter((s) => s.rows.length > 0).length;

const figures = siteSettings.homepageFigures.map(({ section: title, class: cls }) => {
  const section = pulseSections.find((s) => s.title === title);
  if (!section) {
    throw new Error(
      `src/site-settings.ts homepageFigures lists section "${title}", but the latest Procurement Pulse ` +
      `(src/content/procurement/${latest.id}) has no "## ${title}" section.`
    );
  }
  const row = section.rows.find((r) => r.cls === cls);
  if (!row) {
    throw new Error(
      `src/site-settings.ts homepageFigures asks for "${cls}" under "## ${title}", which the latest ` +
      `Procurement Pulse does not have. Available classes: ${section.rows.map((r) => `"${r.cls}"`).join(', ')}.`
    );
  }
  return { ...row, section: title };
});

// A source disclosure (how JLL's chart values were read, say) travels with that source's
// figures: if a featured figure comes from that source, the caveat comes with it.
const disclosures = parsePulseDisclosures(latest.body).filter((d) =>
  figures.some((figure) => figure.source.startsWith(d.source)));

// The standfirst carries counts and then compilation dates; the front door shows the counts.
const counts = latest.data.standfirst.split('·').slice(0, 3).join('·').trim();

const regItems = await getRegulationItems();
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const powerItems = (await getCollection('power')).sort(byOrder);
const watchingItems = (await getCollection('watching')).sort(byOrder);

const showPower = siteSettings.showPowerAndResilience && powerItems.length > 0;
const showWatching = siteSettings.showWhatWereWatching && watchingItems.length > 0;
const showSubscribe = siteSettings.showSubscribe && siteSettings.subscribeFormUrl.trim() !== '';
const lowerPanels = (showPower ? 1 : 0) + (showWatching ? 1 : 0);

const boxIcon = '<path d="M21 16V8l-9-5-9 5v8l9 5z"/><path d="M3.3 7.5L12 12.5l8.7-5"/><path d="M12 12.5V22"/>';
const docIcon = '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>';
const boltIcon = '<path d="M13 2L4.5 13H12l-1 9 8.5-11H12z"/>';
const eyeIcon = '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>';
const checkIcon = '<path d="M20 6L9 17l-5-5"/>';
// One concise national comparison for the homepage. If the two sectors ever differ, both are shown.
const [comChange, indChange] = (['commercial', 'industrial'] as const).map((s) => eiaPrices.us.ytd[s].change_pct);
const homeEiaChange = comChange === indChange ? pct(comChange) : `${pct(comChange)} / ${pct(indChange)}`;
const arrowIcon = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title="DataCenterUpdate" description="Enterprise data center market intelligence: equipment lead times, regulation and grid power, with the source behind every number.">

  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">
          <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.4 6.9H21l-5.4 4.2 2 6.9-5.6-4.3-5.6 4.3 2-6.9L3 8.9h6.6z" /></svg>
          Independent &middot; source-transparent
        </p>
        <h1>What's changing in the enterprise data center market?</h1>
        <p class="lede">Equipment lead times, regulation, and grid power that affect your facility and your next project — with the source behind every number.</p>
        <div class="hero-btns">
          <a class="btn" href="#this-week">See the latest</a>
          <a class="btn btn-ghost" href="/methodology">How we source this</a>
        </div>
      </div>
      <div class="claims">
        <h2>Why another data center site?</h2>
        <ul>
          <li><svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={checkIcon} /><span><b>Enterprise scale.</b> Most published figures describe hyperscale campuses.</span></li>
          <li><svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={checkIcon} /><span><b>Source shown.</b> Who said it, when, and what they measured.</span></li>
          <li><svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={checkIcon} /><span><b>Original sources.</b> Primary records wherever available.</span></li>
          <li><svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={checkIcon} /><span><b>Independent.</b> DCU does not sell the equipment it covers.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- This week: counts of editorial items per section, from src/content/changes -->
  <WeekStrip />

  <!-- Front door: a few sourced figures, the current developments, and the way through to both -->
  <section class="band">
    <div class="wrap">
      <div class="front">

        <article class="fc">
          <div class="fc-h">
            <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true" set:html={boxIcon} />
            <div>
              <h2>Equipment lead times</h2>
              <p class="fc-sub">{latest.data.edition} &middot; {counts}</p>
            </div>
          </div>

          <ul class="figs">
            {figures.map((figure) => (
              <li>
                <div class="fig-l">
                  <span class="fig-cls">{figure.cls}</span>
                  <span class="fig-src"><SourceMark type={figure.sourceType} /><span set:html={figure.sourceHtml} /></span>
                  <span class="fig-sec">{figure.section}</span>
                </div>
                <span class="fig-n">{figure.figure}</span>
              </li>
            ))}
          </ul>

          {disclosures.map((d) => <p class="fc-note" set:html={d.html} />)}
          <p class="fc-note">Ranges differ by equipment class and by who measured them. DCU never averages
            across either, so the full edition shows every figure with its own scope.</p>

          <p class="fc-go"><a href="/procurement">Procurement Pulse &mdash; all {equipmentClassCount} equipment
            classes <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowIcon} /></a></p>
        </article>

        <article class="fc">
          <div class="fc-h">
            <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true" set:html={docIcon} />
            <div>
              <h2>Regulation</h2>
              <p class="fc-sub">Developments affecting where and how data centers get built</p>
            </div>
          </div>

          <ul class="regs">
            {regItems.map((item) => (
              <li>
                <div class="reg-l">
                  <span class="reg-j">{item.data.jurisdiction}</span>
                  <a href={`/regulation/${item.slug}`}>{smartQuotes(item.data.headline)}</a>
                </div>
                <span class="reg-s">{item.data.status}</span>
              </li>
            ))}
          </ul>

          <p class="fc-go"><a href="/regulation">Regulatory Watch &mdash; every item in
            full <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowIcon} /></a></p>
        </article>

        <article class="fc">
          <div class="fc-h">
            <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true" set:html={boltIcon} />
            <div>
              <h2>Power</h2>
              <p class="fc-sub">Grid supply and electricity cost for facilities already running</p>
            </div>
          </div>

          <ul class="figs">
            <li>
              <div class="fig-l">
                <span class="fig-cls">Capacity below PJM's reliability requirement</span>
                <span class="fig-src"><SourceMark type="O" /><a href={pjm.reportUrl}>PJM auction results</a>, {pjm.reportDate}</span>
                <span class="fig-sec">PJM {pjm.deliveryYear} &middot; incl. Virginia and Ohio</span>
              </div>
              <span class="fig-n">{pjm.shortfallMw} MW</span>
            </li>
            <li>
              <div class="fig-l">
                <span class="fig-cls">Estimated reserve margin, against a {pjm.targetReserveMargin} target</span>
                <span class="fig-src"><SourceMark type="O" /><a href={pjm.reportUrl}>PJM auction results</a>, {pjm.reportDate}</span>
                <span class="fig-sec">PJM {pjm.deliveryYear}</span>
              </div>
              <span class="fig-n">{pjm.totalReserveMargin}</span>
            </li>
            <li>
              <div class="fig-l">
                <span class="fig-cls">U.S. average electricity price, commercial and industrial, vs a year earlier</span>
                <span class="fig-src"><SourceMark type="G" /><a href={eiaTableUrls.ytd}>EIA</a>, preliminary, data through {eiaPrices.source.data_month}</span>
                <span class="fig-sec">{eiaYtdLabel}</span>
              </div>
              <span class="fig-n">{homeEiaChange}</span>
            </li>
          </ul>

          <p class="fc-note"><strong>For a facility in PJM:</strong> what is your peak load contribution, how is it
            calculated in your utility zone, and how do capacity charges reach your bill under your supply arrangement?</p>
          <p class="fc-note">EIA figures are national averages, not a facility tariff.</p>
          <p class="fc-note fc-teaser"><strong>Adding 1–5 MW?</strong> <a href="/power/next-mw">Powering the next MW</a>
            sets out seven paths, what the public record shows for each, and where it shows nothing.</p>

          <p class="fc-go"><a href="/power">Power &mdash; both signals in
            full <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowIcon} /></a></p>
        </article>

      </div>
    </div>
  </section>

  <!-- How to read a DCU figure: the source marks used above, in one line -->
  <section class="wrap strip">
    <p class="strip-t">Every figure keeps its source, its date, and the population it measured.</p>
    <ul class="strip-legend">
      {(Object.keys(SOURCE_TYPES) as Array<'R' | 'P' | 'V' | 'G' | 'O'>).map((letter) => (
        <li><SourceMark type={letter} /><span>{SOURCE_TYPES[letter].name}</span></li>
      ))}
    </ul>
    <p class="strip-go"><a href="/methodology">How we source and verify <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowIcon} /></a></p>
  </section>

  <!-- Power & resilience and What we're watching: switched in src/site-settings.ts -->
  {lowerPanels > 0 && (
    <div class="wrap">
      <div class="lower" style={`--cols:${lowerPanels}`}>
        {showPower && (
          <section class="panel" id="power">
            <div class="panel-h">
              <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true" set:html={boltIcon} />
              <h2>Power &amp; resilience</h2>
            </div>
            <p class="sub">What your realistic options are.</p>
            {powerItems.map((item) => <BriefItem item={item} />)}
          </section>
        )}
        {showWatching && (
          <section class="panel" id="watching">
            <div class="panel-h">
              <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true" set:html={eyeIcon} />
              <h2>What we're watching</h2>
            </div>
            <p class="sub">Developments worth monitoring but not yet mature enough to publish as findings.</p>
            {watchingItems.map((item) => <BriefItem item={item} />)}
          </section>
        )}
      </div>
    </div>
  )}

  <!-- Newsletter signup: switched in src/site-settings.ts -->
  {showSubscribe && (
    <section class="sub-band" id="subscribe">
      <div class="wrap sub-in">
        <div class="sub-t">
          <svg class="ico ico-l" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9 6 9-6" /><rect x="3" y="5" width="18" height="14" rx="2" /></svg>
          <div>
            <h2>The important changes, when they matter.</h2>
            <p>Regulation, procurement, and power. Sourced and verified.</p>
          </div>
        </div>
        <form class="form" action={siteSettings.subscribeFormUrl} method="post">
          <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" autocomplete="email" required />
          <input type="hidden" name="embed" value="1" />
          <button class="btn" type="submit">Subscribe</button>
        </form>
      </div>
    </section>
  )}

</Base>

<style>
  .ico { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .ico-s { width: 15px; height: 15px; }
  .ico-l { width: 25px; height: 25px; }

  .btn { display: inline-flex; align-items: center; gap: 7px; background: var(--blue); color: #fff; font-size: 14px; font-weight: 600; padding: 10px 18px; border-radius: 5px; border: 0; cursor: pointer; font-family: inherit; }
  .btn:hover { background: var(--blue-dk); }
  .btn-ghost { background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .45); }
  .btn-ghost:hover { background: rgba(255, 255, 255, .16); }

  /* Hero */
  .hero { background: linear-gradient(180deg, var(--navy) 0%, var(--navy-dk) 100%); color: #fff; padding: 40px 0 46px; }
  .hero-grid { display: grid; gap: 30px; }
  .kicker { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; letter-spacing: .09em; color: #8fb6de; text-transform: uppercase; margin-bottom: 12px; font-weight: 600; }
  .hero h1 { font-size: 31px; line-height: 1.2; margin-bottom: 15px; font-weight: 600; max-width: 19ch; letter-spacing: -.4px; }
  .lede { color: #bfd2e5; max-width: 56ch; margin-bottom: 24px; font-size: 16.5px; }
  .hero-btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .claims { background: rgba(255, 255, 255, .055); border: 1px solid rgba(255, 255, 255, .13); border-radius: 8px; padding: 19px 21px; }
  .claims h2 { font-size: 16px; margin-bottom: 12px; font-weight: 600; }
  .claims ul { list-style: none; }
  .claims li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: #cfe0ef; padding: 6px 0; }
  .claims li svg { color: #5da9f0; margin-top: 3px; }
  .claims li b { color: #fff; font-weight: 600; }

  /* Front door: three cards of equal weight, side by side only when each has room */
  .band { background: var(--page); border-bottom: 1px solid var(--line); padding: 26px 0; }
  .front { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); align-items: stretch; }
  .fc { background: var(--card); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--sh); padding: 18px 19px 16px; display: flex; flex-direction: column; }
  .fc-h { display: flex; gap: 11px; align-items: flex-start; margin-bottom: 14px; }
  .fc-h svg { color: var(--blue); margin-top: 1px; }
  .fc-h h2 { font-size: 18px; font-weight: 600; letter-spacing: -.2px; }
  .fc-sub { font-size: 13px; color: var(--ink-2); margin-top: 2px; }

  /* Figures: class and source on the left, the number on the right */
  .figs, .regs { list-style: none; }
  .figs li { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 14px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line-2); }
  .figs li:first-child, .regs li:first-child { padding-top: 0; }
  .fig-l { min-width: 0; }
  .fig-cls { display: block; font-size: 14.5px; color: var(--ink); overflow-wrap: anywhere; }
  .fig-src { display: block; font-size: 12.5px; color: var(--ink-2); margin-top: 2px; }
  .fig-src :global(a) { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  .fig-sec { display: block; font-size: 11.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; margin-top: 3px; }
  .fig-n { font-size: 16px; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* Regulation: jurisdiction and headline on the left, status on the right */
  .regs li { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 14px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line-2); }
  .reg-l { min-width: 0; }
  .reg-j { display: block; font-size: 11.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }
  .reg-l a { font-size: 14.5px; color: var(--ink); }
  .reg-l a:hover { color: var(--blue); text-decoration: underline; }
  .reg-s { font-size: 12px; font-weight: 600; color: var(--ink-2); background: var(--page); border: 1px solid var(--line); border-radius: 20px; padding: 3px 10px; white-space: nowrap; }

  .fc-note { font-size: 12.5px; line-height: 1.55; color: var(--ink-2); margin-top: 12px; }
  .fc-note :global(strong) { color: var(--ink); font-weight: 600; }
  .fc-note :global(a) { color: var(--blue); text-decoration: underline; }
  .fc-go { margin-top: auto; padding-top: 14px; }
  .fc-go a { font-size: 13.5px; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 5px; }
  .fc-go a:hover { text-decoration: underline; }

  /* Source-type strip */
  .strip { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding-top: 18px; padding-bottom: 4px; }
  .strip-t { font-size: 13.5px; color: var(--ink-2); }
  .strip-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .strip-legend li { display: flex; align-items: center; font-size: 12.5px; color: var(--ink-2); }
  .strip-go a { font-size: 13.5px; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 5px; }
  .strip-go a:hover { text-decoration: underline; }

  /* Lower panels (off unless switched on in site-settings) */
  .lower { display: grid; gap: 20px; margin-top: 20px; grid-template-columns: minmax(0, 1fr); }
  .lower .panel { margin-top: 0; min-width: 0; }
  .panel-h { display: flex; gap: 10px; align-items: center; margin-bottom: 5px; }
  .panel-h svg { color: var(--blue); }
  .panel-h h2 { font-size: 21px; font-weight: 600; letter-spacing: -.25px; }
  .sub { font-size: 14px; color: var(--ink-2); margin-bottom: 18px; }

  /* Subscribe band */
  .sub-band { background: linear-gradient(180deg, var(--navy-mid), var(--navy)); color: #fff; margin-top: 26px; padding: 34px 0; }
  .sub-in { display: grid; gap: 20px; align-items: center; }
  .sub-t { display: flex; gap: 14px; align-items: flex-start; }
  .sub-t svg { color: #5da9f0; margin-top: 3px; }
  .sub-band h2 { font-size: 21px; margin-bottom: 5px; font-weight: 600; }
  .sub-band p { color: #bfd2e5; font-size: 14px; }
  .form { display: flex; gap: 9px; flex-wrap: wrap; }
  .form input { flex: 1 1 210px; padding: 12px 14px; border: 1px solid #3d5c7c; border-radius: 5px; font-size: 16px; background: #fff; color: var(--ink); min-width: 0; font-family: inherit; }

  @media (min-width: 640px) {
    .hero h1 { font-size: 36px; }
  }
  @media (min-width: 1080px) {
    .front { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  }
  @media (min-width: 900px) {
    .hero h1 { font-size: 40px; }
    .hero-grid { grid-template-columns: 1.5fr 1fr; align-items: center; }
    .lower { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .sub-in { grid-template-columns: 1.3fr 1fr; }
  }
</style>
