---
import Base from './Base.astro';
const { title, description, lede } = Astro.props;
---
<Base title={title} description={description}>
  <section class="page-head">
    <div class="wrap">
      <slot name="kicker" />
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </div>
  </section>

  <div class="wrap">
    <article class="panel panel-reading prose">
      <slot />
    </article>
  </div>
</Base>
