---
// "What changed this week" at the top of a section page, from src/content/changes.
// It shows the reader's current Monday-Sunday week (Eastern time). If nothing has been published
// yet this week, it shows the most recent earlier week, labelled with its dates, rather than
// claiming there are no updates. The "no updates" message appears only when the section has no
// published entries at all.
//
// Only the week on show is written into the page, so text-only readers and link previews never
// see two contradictory states. Every entry also travels as data (data-week-entries), and
// src/scripts/this-week.ts redraws the box with the same rule (src/lib/weeks.ts) when a page
// built in an earlier week is read in a later one.
import { getChanges, weekView, weekLabel, within, changeDate, SECTION_LABELS, type Section } from '../lib/changes';

interface Props { section: Section }
const { section } = Astro.props;

const kindLabel = { new: 'New', update: 'Update', correction: 'Correction' } as const;
const entries = (await getChanges(section)).map((c) => ({
  date: changeDate(c),
  day: c.data.date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', timeZone: 'UTC' }),
  kind: kindLabel[c.data.kind],
  kindClass: `tw-${c.data.kind}`,
  title: c.data.title,
  href: c.data.href,
}));
const view = weekView(entries.map((e) => e.date));
const shown = entries.filter((e) => within(e.date, view.week));
const sectionLabel = SECTION_LABELS[section];
---
<section class="tw" id="this-week" data-week-list aria-labelledby="tw-title">
  <div class="tw-h">
    <h2 id="tw-title">What changed this week</h2>
    <p data-week-status>
      {view.mode === 'latest'
        ? <Fragment>Nothing new yet this week ({weekLabel(view.current)}). Latest changes, {weekLabel(view.week)}:</Fragment>
        : <Fragment>{weekLabel(view.week)} · Monday to Sunday, Eastern time</Fragment>}
    </p>
  </div>
  {entries.length > 0 ? (
    <ul data-week-items>
      {shown.map((e) => (
        <li>
          <time datetime={e.date}>{e.day}</time>
          <span class={`tw-k ${e.kindClass}`}>{e.kind}</span>
          <a href={e.href}>{e.title}</a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="tw-empty"><strong>No editorial updates to {sectionLabel} this week.</strong> The regular page content follows below.</p>
  )}
  <script type="application/json" data-week-entries set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />
</section>

<script>
  import '../scripts/this-week';
</script>

<style>
  .tw { background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--blue); border-radius: 6px; padding: 12px 16px; margin: 20px 0 0; max-width: 780px; }
  .tw-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .tw-h h2 { font-size: 15px; font-weight: 600; }
  .tw-h p { font-size: 12.5px; color: var(--ink-2); }
  .tw ul { list-style: none; margin-top: 8px; }
  /* :global so rows redrawn in the browser (src/scripts/this-week.ts) get the same styles */
  .tw :global(li) { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 10px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--line-2); font-size: 14px; }
  .tw :global(time) { font-size: 12.5px; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .tw :global(.tw-k) { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-2); }
  .tw :global(.tw-correction) { color: var(--red); }
  .tw :global(a:not(.cls)) { color: var(--blue-dk); }
  .tw :global(a:hover) { text-decoration: underline; }
  .tw-empty { font-size: 14px; color: var(--ink-2); margin-top: 6px; }
  .tw-empty strong { color: var(--ink); font-weight: 600; }
</style>
