---
// "What changed this week" at the top of a section page. Lists that section's entries from
// src/content/changes for the current Monday-Sunday week (Eastern time); older entries stay
// in the page hidden so the browser can recount if the page was built in an earlier week.
import { getChanges, easternWeek, weekLabel, inWeek, changeDate, type Section } from '../lib/changes';

interface Props { section: Section }
const { section } = Astro.props;

const week = easternWeek();
const entries = await getChanges(section);
const shown = entries.filter((c) => inWeek(c, week)).length;
const kindLabel = { new: 'New', update: 'Update', correction: 'Correction' } as const;
const day = (c: (typeof entries)[number]) =>
  c.data.date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', timeZone: 'UTC' });
---
<section class="tw" id="this-week" data-week-list aria-labelledby="tw-title">
  <div class="tw-h">
    <h2 id="tw-title">What changed this week</h2>
    <p><span data-week-label>{weekLabel(week)}</span> · Monday to Sunday, Eastern time</p>
  </div>
  <ul data-week-items hidden={shown === 0}>
    {entries.map((c) => (
      <li data-date={changeDate(c)} hidden={!inWeek(c, week)}>
        <time datetime={changeDate(c)}>{day(c)}</time>
        <span class={`tw-k tw-${c.data.kind}`}>{kindLabel[c.data.kind]}</span>
        <a href={c.data.href}>{c.data.title}</a>
      </li>
    ))}
  </ul>
  <p class="tw-empty" data-week-empty hidden={shown > 0}>Nothing new or changed in this section this week. The current content follows.</p>
</section>

<script>
  import '../scripts/this-week';
</script>

<style>
  .tw { background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--blue); border-radius: 6px; padding: 12px 16px; margin: 20px 0 0; max-width: 780px; }
  .tw-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .tw-h h2 { font-size: 15px; font-weight: 600; }
  .tw-h p { font-size: 12.5px; color: var(--ink-2); }
  .tw ul { list-style: none; margin-top: 8px; }
  .tw li { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 10px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--line-2); font-size: 14px; }
  .tw li[hidden] { display: none; }
  .tw time { font-size: 12.5px; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .tw-k { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-2); }
  .tw-correction { color: var(--red); }
  .tw a { color: var(--blue-dk); }
  .tw a:hover { text-decoration: underline; }
  .tw-empty { font-size: 13.5px; color: var(--ink-2); margin-top: 6px; }
</style>
