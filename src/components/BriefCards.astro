---
// Picture cards for briefs: four across on desktop, two on tablet, one on phones.
// Used for the homepage row (featured briefs) and the /briefs list.
import type { CollectionEntry } from 'astro:content';
import { SOURCE_TYPES } from '../lib/source-types.mjs';
import { smartQuotes } from '../lib/typography';
import { readMinutes } from '../lib/briefs';
import { siteSettings } from '../site-settings';
import { BRIEF_TOPICS } from '../lib/brief-topics';

interface Props {
  briefs: CollectionEntry<'briefs'>[];
  /** Desktop columns. Four unless a launched homepage row has fewer published briefs. */
  columns?: number;
}

const { briefs, columns = 4 } = Astro.props;
---
<div class="bc-grid" style={`--bc-cols:${columns};--bc-ratio:${siteSettings.briefCardImageRatio}`}>
  {briefs.map((b) => (
    <a class={`bc${b.data.status === 'draft' ? ' bc-is-draft' : ''}`} href={`/briefs/${b.slug}`}>
      {b.data.status === 'draft' && <span class="bc-draft">Draft · preview only</span>}
      <img class="bc-img" src={b.data.image} alt={b.data.imageAlt} width="800" height="800" loading="lazy" decoding="async" style={`object-position:${b.data.imagePosition}`} />
      <div class="bc-body">
        <span class="bc-t">{smartQuotes(b.data.cardTitle)}</span>
        <span class="bc-d">{smartQuotes(b.data.dek)}</span>
        <span class="bc-m">
          {/* The card is one link, so a source marker here is a plain label, not its own link */}
          {b.data.sourceType && <span class={`cls c-${b.data.sourceType.toLowerCase()}`} title={`${SOURCE_TYPES[b.data.sourceType].name} source`} aria-hidden="true">{b.data.sourceType}</span>}
          Brief &middot; {readMinutes(b.body)} min read
          <span class={`bc-topic ${BRIEF_TOPICS[b.data.section]}`}>{b.data.section}</span>
        </span>
      </div>
    </a>
  ))}
</div>

<style>
  .bc-grid { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  .bc { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--sh); overflow: hidden; display: flex; flex-direction: column; color: var(--ink); }
  .bc:hover .bc-t { color: var(--blue); text-decoration: underline; }
  .bc-img { display: block; width: 100%; height: auto; aspect-ratio: var(--bc-ratio); object-fit: cover; background: var(--navy); }
  .bc-body { padding: 14px 16px 15px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .bc-t { font-size: 15.5px; font-weight: 600; line-height: 1.3; letter-spacing: -.1px; }
  .bc-d { font-size: 13px; color: var(--ink-2); line-height: 1.5; }
  .bc-m { display: flex; align-items: center; gap: 0 6px; font-size: 12.5px; color: var(--ink-3); margin-top: auto; padding-top: 6px; }
  .bc-m .cls { margin-right: 0; }
  /* Preview only: drafts never reach the live site */
  .bc-is-draft { border-top: 4px solid #f2b705; }
  .bc-draft { position: absolute; top: 8px; left: 8px; font-size: 11px; font-weight: 600; color: var(--navy); background: #ffd98a; padding: 1px 7px; border-radius: 3px; }
  /* Topic pill, bottom right */
  .bc-topic { margin-left: auto; font-size: 11.5px; font-weight: 600; padding: 2px 9px; border-radius: 20px; border: 1px solid; white-space: nowrap; }
  .tp-power       { color: #3730a3; background: #eef0fb; border-color: #d5d9f3; }
  .tp-cooling     { color: #0369a1; background: #e8f4fb; border-color: #c6e2f3; }
  .tp-water       { color: #0f766e; background: #e6f5f2; border-color: #c3e5de; }
  .tp-resilience  { color: #9d174d; background: #fbeef3; border-color: #f0cfdc; }
  .tp-colocation  { color: #6d28d9; background: #f3eefd; border-color: #ddd0f7; }
  .tp-procurement { color: #7c4a1e; background: #f7efe6; border-color: #e9d6c1; }
  .tp-regulation  { color: #475569; background: #eef1f5; border-color: #d6dde6; }
  .tp-standards   { color: #4d7c0f; background: #f0f6e6; border-color: #d5e6bd; }
  @media (min-width: 640px) { .bc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .bc-grid { grid-template-columns: repeat(var(--bc-cols), minmax(0, 1fr)); gap: 20px; } }
</style>
