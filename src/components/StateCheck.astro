---
// "Check your state": a visitor picks a state and sees its average commercial and industrial
// electricity prices from the latest EIA edition, how they moved in a year, and any regulatory
// development we track there. Data is read from the site's own files; the browser only looks it up.
// The visitor's choice is remembered in their own browser only.
import { getRegulationItems } from '../lib/regulation';
import { eiaPrices } from '../lib/power';
import { regStatusClass } from '../lib/reg-status';
import { smartQuotes } from '../lib/typography';

const { source, states, us } = eiaPrices;
const regItems = await getRegulationItems();
const payload = JSON.stringify({
  states: states.map((s) => ({
    code: s.code, name: s.name,
    c: [s.commercial.current, s.commercial.change_pct, s.commercial.rank_label],
    i: [s.industrial.current, s.industrial.change_pct, s.industrial.rank_label],
  })),
  regs: regItems.map((r) => ({ where: r.data.state ?? r.data.jurisdiction, place: r.data.jurisdictionType === 'local' ? r.data.jurisdiction.split(',')[0] : '',
    headline: smartQuotes(r.data.headline), status: r.data.status,
    cls: regStatusClass(r.data.status), href: `/regulation/${r.slug}` })),
  us: { c: [us.commercial.current, us.commercial.change_pct], i: [us.industrial.current, us.industrial.change_pct] },
}).replace(/</g, '\\u003c');
const sign = (p: number) => (p > 0 ? '+' : p < 0 ? '−' : '') + Math.abs(p).toFixed(1) + '%';
---
<section class="sc" id="check-state" aria-labelledby="sc-title">
  <div class="sc-pick">
    <h2 id="sc-title">Check your state</h2>
    <p class="sc-what">Average business electricity prices, how they moved in a year, and what we track there.</p>
    <select id="sc-state" aria-label="Choose a state">
      <option value="">United States (all states)</option>
      {states.map((s) => <option value={s.code}>{s.name}</option>)}
    </select>
    <p class="sc-src">EIA, {source.current_label} vs {source.prior_label}, preliminary. State averages, not your tariff.</p>
  </div>
  <div class="sc-out" id="sc-out" aria-live="polite">
    <div class="sc-col">
      <span class="sc-k">Commercial</span>
      <span class="sc-v" data-f="cv">{us.commercial.current.toFixed(2)}¢<small>/kWh</small></span>
      <span class="sc-c" data-f="cc">{sign(us.commercial.change_pct)} in a year</span>
      <span class="sc-r" data-f="cr">U.S. average</span>
    </div>
    <div class="sc-col">
      <span class="sc-k">Industrial</span>
      <span class="sc-v" data-f="iv">{us.industrial.current.toFixed(2)}¢<small>/kWh</small></span>
      <span class="sc-c" data-f="ic">{sign(us.industrial.change_pct)} in a year</span>
      <span class="sc-r" data-f="ir">U.S. average</span>
    </div>
    <div class="sc-col sc-regs">
      <span class="sc-k" data-f="rk">Tracked nationally</span>
      <div data-f="regs">
        {regItems.filter((r) => r.data.jurisdiction === 'Federal').map((r) => (
          <a class="sc-reg" href={`/regulation/${r.slug}`}><span class={`sc-pill ${regStatusClass(r.data.status)}`}>{r.data.status}</span><span>{smartQuotes(r.data.headline)}</span></a>
        ))}
      </div>
      <a class="sc-more" href="/power">Every state on the Power page &rarr;</a>
    </div>
  </div>
  <script type="application/json" id="sc-data" set:html={payload} />
</section>

<script>
  const data = JSON.parse(document.getElementById('sc-data')!.textContent || '{}');
  const select = document.getElementById('sc-state') as HTMLSelectElement;
  const out = document.getElementById('sc-out')!;
  const f = (name: string) => out.querySelector(`[data-f="${name}"]`) as HTMLElement;
  const sign = (p: number) => (p > 0 ? '+' : p < 0 ? '−' : '') + Math.abs(p).toFixed(1) + '%';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const price = (v: number) => `${v.toFixed(2)}¢<small>/kWh</small>`;
  type Reg = { where: string; place: string; headline: string; status: string; cls: string; href: string };
  const regLine = (r: Reg) => `<a class="sc-reg" href="${r.href}"><span class="sc-pill ${r.cls}">${esc(r.status)}</span><span>${r.place && !r.headline.startsWith(r.place) ? `<b>${esc(r.place)}:</b> ` : ''}${esc(r.headline)}</span></a>`;

  function show(code: string) {
    const s = data.states.find((x: { code: string }) => x.code === code);
    const regs: Reg[] = data.regs;
    if (!s) {
      f('cv').innerHTML = price(data.us.c[0]); f('cc').textContent = `${sign(data.us.c[1])} in a year`; f('cr').textContent = 'U.S. average';
      f('iv').innerHTML = price(data.us.i[0]); f('ic').textContent = `${sign(data.us.i[1])} in a year`; f('ir').textContent = 'U.S. average';
      f('rk').textContent = 'Tracked nationally';
      f('regs').innerHTML = regs.filter((r) => r.where === 'Federal').map(regLine).join('');
      return;
    }
    f('cv').innerHTML = price(s.c[0]); f('cc').textContent = `${sign(s.c[1])} in a year`; f('cr').textContent = `${s.c[2]} · U.S. ${sign(data.us.c[1])}`;
    f('iv').innerHTML = price(s.i[0]); f('ic').textContent = `${sign(s.i[1])} in a year`; f('ir').textContent = `${s.i[2]} · U.S. ${sign(data.us.i[1])}`;
    const local = regs.filter((r) => r.where === s.name);
    f('rk').textContent = local.length ? `Tracked in ${s.name}` : `Nothing tracked in ${s.name} yet · nationally`;
    f('regs').innerHTML = (local.length ? local : regs.filter((r) => r.where === 'Federal')).map(regLine).join('');
  }

  select.addEventListener('change', () => {
    show(select.value);
    try { localStorage.setItem('dcu-state', select.value); } catch { /* private window: works, just not remembered */ }
  });
  const fromHash = location.hash.match(/state=([A-Z]{2})/)?.[1];
  let saved = '';
  try { saved = localStorage.getItem('dcu-state') || ''; } catch { /* ignore */ }
  const start = fromHash || saved;
  if (start && data.states.some((x: { code: string }) => x.code === start)) { select.value = start; show(start); }
</script>

<style>
  .sc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; background: var(--card); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--sh); padding: 18px 19px; margin-bottom: 20px; }
  .sc h2 { font-size: 18px; font-weight: 600; letter-spacing: -.2px; }
  .sc-what { font-size: 13.5px; color: var(--ink-2); margin: 3px 0 10px; }
  .sc select { width: 100%; font: inherit; font-size: 15px; padding: 9px 11px; border-radius: 6px; border: 1px solid var(--line); background: #fff; color: var(--ink); }
  .sc-src { font-size: 12px; color: var(--ink-3); margin-top: 8px; line-height: 1.45; }
  .sc-out { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 18px; }
  .sc-col { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .sc-regs { grid-column: 1 / -1; }
  .sc-k { font-size: 11.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  .sc-v { font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.15; }
  .sc-v :global(small) { font-size: 12.5px; font-weight: 400; color: var(--ink-2); }
  .sc-c { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .sc-r { font-size: 12.5px; color: var(--ink-2); }
  .sc-out :global(.sc-reg) { display: flex; gap: 8px; align-items: baseline; font-size: 14px; color: var(--ink); line-height: 1.4; padding: 3px 0; }
  .sc-out :global(.sc-reg:hover) { color: var(--blue); text-decoration: underline; }
  .sc-out :global(.sc-pill) { flex: none; font-size: 11.5px; font-weight: 600; padding: 1px 8px; border-radius: 20px; border-width: 1px; border-style: solid; }
  .sc-more { font-size: 13.5px; font-weight: 600; color: var(--blue); margin-top: 6px; }
  .sc-more:hover { text-decoration: underline; }
  @media (min-width: 900px) {
    .sc { grid-template-columns: minmax(0, .9fr) minmax(0, 2.1fr); gap: 26px; align-items: start; }
    .sc-out { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr); }
    .sc-regs { grid-column: auto; }
  }
</style>
